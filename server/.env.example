# Inventory AI — Backend environment (Phase 02)
# Copy this file to `.env` and set local values.
# Never commit real credentials. `.env` is git-ignored.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string. Set the real value only in server/.env — never commit it.
# Required in production (NODE_ENV=production): startup fails fast if it is missing.
# The URI names the CLUSTER and the credentials; the DATABASE is chosen separately
# — see MONGODB_DB_NAME below. Development, test and production may therefore share
# one cluster and one connection string without ever sharing data.
MONGODB_URI=

# The database this process uses. Leave EMPTY for the normal case — each
# environment then gets its own database automatically:
#
#   development (NODE_ENV=development, or unset)  ->  inventoryai_dev_db
#   test        (TEST_MODE set by run-tests.mjs,
#                or NODE_ENV=test)                ->  inventoryai_test_db
#   production  (NODE_ENV=production, e.g. Render)->  inventoryai_prod_db
#
# Resolution order (config/env.ts): a test run always uses the test database;
# otherwise this variable, when set; otherwise the NODE_ENV default above.
#
# A test run is FAIL-CLOSED: it uses inventoryai_test_db whatever this variable
# says, so tests cannot reach the development or production database. Two
# combinations are refused at startup instead of resolved: TEST_MODE together
# with NODE_ENV=production, and choosing a database that belongs to another
# environment (production naming a development/test database, or a
# non-production environment naming the production database).
#
# The pre-separation shared database `inventory_ai` is never resolved to.
#
# Set it only to give an environment a database of its own — e.g. a staging
# deployment — and never to a value belonging to another environment.
MONGODB_DB_NAME=

# JWT signing secret (Phase 03). Generate a strong random value in server/.env — never commit it.
# Example: openssl rand -hex 48
# Required in production and must be >= 32 characters (startup fails fast otherwise).
JWT_SECRET=

# Access-token lifetime (optional; default "1h"). jsonwebtoken timespan format,
# e.g. "1h", "15m", "2h", or a plain number of seconds. In production a value
# jsonwebtoken cannot parse fails fast at startup (never a first-login 500).
#
# AUTH-02: this is the JWT's lifetime only. Session longevity is bounded
# separately by the 14-day absolute Inventory session cap (code, not config), so
# changing this value never lengthens or shortens a session's usable life.
JWT_EXPIRES_IN=1h

# Application access-token issuer/audience (optional; these defaults ship).
# Stable, non-secret labels, validated by jsonwebtoken on every request. They are
# deliberately NOT environment-specific — do not put a host, port, NODE_ENV or
# Firebase project id here. Tokens minted before AUTH-02 carry neither claim and
# are rejected, so every existing user signs in once more after this change.
JWT_ISSUER=inventory-ai
JWT_AUDIENCE=inventory-ai-api

# ---------------------------------------------------------------------------
# Firebase Authentication (Phase 32B). Server-side credentials ONLY.
# NEVER sent to the mobile app, NEVER committed, NEVER pasted into a chat.
#
# OPTIONAL and fully additive. With nothing set here the server runs exactly as
# it did before: Firebase is disabled and no route uses it. In production a
# PARTIALLY supplied service account fails fast at startup; an entirely empty one
# does not — so adding this section cannot break an existing deployment.
#
# Supply the credential ONE of two ways. If FIREBASE_SERVICE_ACCOUNT_JSON is set,
# it is used and the three individual variables below are ignored entirely.
# ---------------------------------------------------------------------------

# PREFERRED for a hosted deployment (Render, Railway, ...): the entire
# service-account JSON in one value, either verbatim or base64-encoded. This form
# removes a failure the three-variable form cannot: a PEM private key pasted
# through a web dashboard routinely loses its line breaks.
#
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# The downloaded JSON is the value. It grants full admin access to the Firebase
# project — treat it like a database password.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternative three-variable form. Set ALL THREE or NONE — a partial set is a
# startup failure in production, and is ignored when the JSON variable above is set.
#
# The project id is not a secret (it is part of the public client configuration);
# the client email and private key are.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The service account's PEM private key. A literal \n sequence is accepted and
# converted to a real newline, so the value can be stored on a single line.
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# AI Assistant (Phase 06). Keys stay server-side ONLY — never sent to the app.
# ---------------------------------------------------------------------------

# Which provider to use for the AI assistant: "openrouter".
#   openrouter  = an Anthropic-compatible gateway (/api/v1/messages) in front of
#                 many models; the model is REQUIRED (see below).
# Leave empty to run the server with the AI assistant disabled (chat returns 503).
#
# ONE provider, on purpose (AI-25): the direct Claude and Gemini implementations
# were removed, because both are reachable through this gateway as MODEL choices
# and the direct paths needed their own keys, model variables and billing to be
# usable. Changing the model is `AI_MODEL_OPENROUTER`, not a code change.
#
# In production the configured provider's settings are required at startup
# (fail fast): openrouter -> OPENROUTER_API_KEY + OPENROUTER_BASE_URL +
# AI_MODEL_OPENROUTER. Empty = AI disabled, which is valid.
AI_PROVIDER=

# Provider keys. Set real values only in server/.env — never commit them.

# OpenRouter gateway (Anthropic-compatible /v1/messages). Server-side ONLY — the
# key is never sent to the app or to MongoDB, and is sent only in the
# Authorization: Bearer header. No claude-cli/claude-code impersonation headers
# are used here: OpenRouter has no client-fingerprint requirement.
#
# OPENROUTER_BASE_URL is the origin-ish prefix; /v1/messages is appended. Set it
# to exactly the base OpenRouter documents:
OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=
# REQUIRED, and deliberately with no default: OpenRouter fronts hundreds of models
# with very different tool-calling ability, so an assistant model must be named
# explicitly. Use a provider/model slug that supports tools, e.g.
# "anthropic/claude-sonnet-4.5". Set it to a model you have verified yourself —
# a model that cannot call tools cannot answer inventory questions.
AI_MODEL_OPENROUTER=

# Optional tuning (defaults shown).
# (AI_MODEL_OPENROUTER has no default — see the OpenRouter block above.)
# AI_MAX_MESSAGE_CHARS=4000
# AI_MAX_OUTPUT_TOKENS=1200
# AI_MAX_TOOL_ITERATIONS=6
# AI_CONTEXT_MESSAGES=20
# AI_REQUEST_TIMEOUT_MS=60000
# One wall-clock budget for a WHOLE chat turn (AI-1). The turn's ceiling used to be
# the *product* of AI_REQUEST_TIMEOUT_MS and AI_MAX_TOOL_ITERATIONS, which stated no
# intent and let a turn run for minutes; this bounds it directly, and each provider
# call is clamped to the time remaining. The mobile client's AI_REQUEST_TIMEOUT_MS
# must stay above this — `mobile/__tests__/ai1-turn-time-budget.test.ts` fails if it
# does not.
# AI_TURN_DEADLINE_MS=60000
# How many times a turn retries a provider response that carries NO usable content
# (neither text nor a tool call) before the turn is marked degraded (AI-2). The
# deployed free-tier gateway returned one in roughly three turns out of five on
# 2026-10-12, and the turn used to be shown to the member as an ordinary 201 with
# nothing recorded. The retry shares AI_MAX_TOOL_ITERATIONS and the turn deadline,
# so raising it cannot extend a turn or make it loop. Minimum 1.
# AI_EMPTY_RETRY_MAX=1
# AI_RATE_LIMIT_WINDOW_MS=60000
# AI_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# Email delivery + password recovery (Phase 26B-1 / 26B-3). Defaults shown.
#
# Password recovery is DISABLED unless MAIL_PROVIDER names a configured provider
# AND PASSWORD_RESET_URL is set. Both are checked BEFORE any reset token is
# created, and POST /api/auth/forgot-password answers a fixed 503 while they are
# missing. Nothing here is ever sent to the mobile app.
# ---------------------------------------------------------------------------

# Which provider sends mail. Leave empty to disable password recovery entirely.
# This project uses Brevo in development and production. The key below goes in
# server/.env only — never commit it.
MAIL_PROVIDER=

# Verified sender, in the form `Name <address@your-domain>`. The address must be
# one the provider has verified, or every send is rejected. This one value is
# shared by every provider: the Brevo transport splits it into Brevo's structured
# `sender: { name, email }` locally, so no Brevo-specific sender variable exists.
MAIL_FROM=

# Brevo API key (https://www.brevo.com → SMTP & API → API Keys). Required when
# MAIL_PROVIDER=brevo. Server-side ONLY — it is never returned in a response or
# written to a log.
BREVO_API_KEY=

# Optional. Product name shown inside the reset email. Default: "Inventory AI".
# MAIL_APP_NAME=Inventory AI

# Optional. Abort a provider request that takes longer than this (ms).
# MAIL_REQUEST_TIMEOUT_MS=10000

# The trusted page a reset link points at. This is the ONLY source of the reset
# URL — it is never built from the Host/Origin/Referer headers or from anything
# a client sends. Point it at your own app's reset screen, which reads the
# `token` query parameter and POSTs it back to /api/auth/reset-password.
PASSWORD_RESET_URL=

# ---------------------------------------------------------------------------
# AUTH-04 — email-verification code pepper (design authority §14C.10).
#
# The custom 6-digit verification code is stored only as an HMAC-SHA256 digest
# keyed by this secret. There is deliberately NO unkeyed fallback: when the
# AUTH-04 flow is configured but this value is missing, empty or malformed, the
# AUTH-04 endpoints answer 503 EMAIL_VERIFICATION_NOT_CONFIGURED. Production
# fail-fast rejects a missing value when the flow is configured. Server-side
# ONLY — never returned in a response, never written to a log, never committed.
#
# AUTH-04-A reads this variable (config/emailVerification.ts). The challenge
# primitives, mail template, Admin bridge, request/confirm lifecycles, their HTTP routes
# and their rate limiters are all shipped (AUTH-04-A..D); AUTH-04-E adds the server
# hardening close-out (source guards and the consolidation test pass).
# The rule today is already the shipped one: with a Firebase service account
# configured, a missing or too-short (<32 char) pepper is a PRODUCTION startup
# failure; with no Firebase configured it is not required at all.
# ---------------------------------------------------------------------------
EMAIL_VERIFICATION_CODE_PEPPER=

# ---------------------------------------------------------------------------
# Public auth rate limiting + proxy (Phase 07B). Defaults shown; all optional.
# Login is limited per IP + normalized email (strict) AND per IP (higher cap,
# catches password spraying). Register is limited per IP. Only failed logins
# consume the login budget, so legitimate users are never locked out.
# ---------------------------------------------------------------------------

# Login — per IP + account: max FAILED attempts in the window.
# AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
# AUTH_LOGIN_RATE_LIMIT_MAX=10
# Login — per IP overall cap (password spraying across accounts).
# AUTH_LOGIN_IP_RATE_LIMIT_WINDOW_MS=900000
# AUTH_LOGIN_IP_RATE_LIMIT_MAX=60
# Registration — per IP, every attempt.
# AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
# AUTH_REGISTER_RATE_LIMIT_MAX=30

# Password recovery (Phase 26B-3). Unlike login, EVERY attempt counts — the
# success and no-such-account paths are deliberately indistinguishable, so there
# is no failure to skip. Both routes answer 429 with code PASSWORD_RESET_RATE_LIMITED.
# forgot-password — per IP + normalized email (bounds mail to one inbox).
# AUTH_PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
# AUTH_PASSWORD_RESET_RATE_LIMIT_MAX=5
# forgot-password — per IP overall cap (address rotation backstop).
# AUTH_PASSWORD_RESET_IP_RATE_LIMIT_WINDOW_MS=3600000
# AUTH_PASSWORD_RESET_IP_RATE_LIMIT_MAX=20
# reset-password — per IP (each accepted attempt costs a bcrypt hash).
# AUTH_PASSWORD_RESET_CONFIRM_RATE_LIMIT_WINDOW_MS=900000
# AUTH_PASSWORD_RESET_CONFIRM_RATE_LIMIT_MAX=20

# Firebase authentication (Phase 32C). Like the recovery routes, EVERY attempt
# counts — a successful exchange is a 2xx, so skipping successes would exempt the
# very traffic the limiter exists to bound. Both routes answer 429 with code
# FIREBASE_RATE_LIMITED. Each is per IP only; see middlewares/rateLimit.ts for
# why no identity-keyed bucket exists (the identity is unknown until after
# verification, and the ID token rotates, so it is not a stable key).
# firebase/exchange — per IP (each accepted request costs a signature verification).
# AUTH_FIREBASE_EXCHANGE_RATE_LIMIT_WINDOW_MS=900000
# AUTH_FIREBASE_EXCHANGE_RATE_LIMIT_MAX=30
# firebase/register — per IP (mass account creation, mirroring /register).
# AUTH_FIREBASE_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
# AUTH_FIREBASE_REGISTER_RATE_LIMIT_MAX=30

# AUTH-03 session renewal — per IP, counting every attempt (each accepted request
# costs a Firebase checkRevoked verification). The cap is deliberately generous
# (120 vs login's 60) because renewal is routine and several devices behind one
# NAT share the bucket. Answers 429 with code SESSION_RENEW_RATE_LIMITED and a
# Retry-After header; the client must treat that as transient and preserve the
# still-valid session.
# AUTH_SESSION_RENEW_RATE_LIMIT_WINDOW_MS=900000
# AUTH_SESSION_RENEW_RATE_LIMIT_MAX=120

# AUTH-04 email verification (AD-19). Both routes are PRE-SESSION and
# Firebase-authenticated, so there is no stable pre-verification identity to key
# on (the identity is known only AFTER verification) — each is limited PER IP
# ONLY. Unlike login, EVERY attempt counts: a successful request is a 2xx, so
# skipping successes would exempt precisely the traffic the limiter exists to
# bound. Both answer 429 with code EMAIL_VERIFICATION_RATE_LIMITED and a
# draft-7 Retry-After. The per-identity control is AUTH-04-B3's 60-second resend
# cooldown, a separate budget enforced in the service — not a route limiter.
# email-verification/request — per IP (each accepted request mints a challenge,
# writes a row and sends one email).
# AUTH_EMAIL_VERIFICATION_REQUEST_RATE_LIMIT_WINDOW_MS=900000
# AUTH_EMAIL_VERIFICATION_REQUEST_RATE_LIMIT_MAX=30
# email-verification/confirm — per IP (bounds code guessing; each attempt costs a
# reservation, an HMAC compare and possibly an Admin write).
# AUTH_EMAIL_VERIFICATION_CONFIRM_RATE_LIMIT_WINDOW_MS=900000
# AUTH_EMAIL_VERIFICATION_CONFIRM_RATE_LIMIT_MAX=30

# Number of trusted reverse-proxy hops in front of this server (Render,
# Railway, a load balancer, etc.). Default 0 = trust no proxy (safe: forwarded
# headers are ignored, rate limits key on the direct peer). Set to the EXACT
# hop count (usually 1) when deployed behind a proxy so client IP detection —
# and IP-based rate limiting — sees real clients. Never set to `true`.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# HTTP security hardening (Phase 07C). Defaults shown; all optional.
# ---------------------------------------------------------------------------

# Explicit CORS allow-list: comma-separated exact browser origins. Native
# mobile sends no Origin and is unaffected. A browser origin is granted CORS
# ONLY if listed here — the API never emits `Access-Control-Allow-Origin: *`.
# Leave empty (default) to deny every browser origin (there are no web clients
# in V1). Set real, owned domains only — never placeholder marketing domains.
# CORS_ORIGINS=https://admin.example.com,https://example.com

# JSON request-body size cap accepted by express.json() (byte count or the
# '100kb' style). Kept small on purpose — every V1 endpoint's validated fields
# are well under it, and oversized bodies are rejected cleanly with a 413.
# JSON_BODY_LIMIT=100kb

# ---------------------------------------------------------------------------
# Production configuration + operational reliability (Phase 07D). Defaults shown.
# ---------------------------------------------------------------------------

# Graceful shutdown grace period (ms) on SIGTERM/SIGINT: how long the process
# waits for in-flight requests to drain before force-exiting. Bounded on purpose
# so a stuck request can never hold a deploy/restart hostage.
# SHUTDOWN_TIMEOUT_MS=10000

# When NODE_ENV=production the server FAILS FAST at startup (non-zero exit,
# before accepting traffic) if any of these are invalid:
#   - MONGODB_URI is missing or MongoDB cannot be connected
#   - the resolved database name contradicts the environment (see MONGODB_DB_NAME)
#   - JWT_SECRET is missing or shorter than 32 characters
#   - JWT_EXPIRES_IN is set to a value jsonwebtoken cannot parse
#   - AI_PROVIDER is set but the configured provider's required key(s) are missing
#   - a Firebase service account is PARTIALLY configured (some but not all of
#     FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY, or a
#     FIREBASE_SERVICE_ACCOUNT_JSON that does not parse into one). Setting no
#     Firebase variable at all is valid — Firebase stays disabled.
# Error messages name only the VARIABLE that is wrong — secret values are never
# printed. In development/test these checks are lenient.
#
# Health endpoints:
#   GET /api/health        (legacy) 200 always + current db state
#   GET /api/health/live   (liveness) 200 always — never touches MongoDB
#   GET /api/health/ready  (readiness) 200 only when MongoDB is reachable, else 503
# While MongoDB is unreachable, database requests return a fixed 503 (code
# DB_UNAVAILABLE) rather than a driver error or a stack trace.

# ---------------------------------------------------------------------------
# Structured request logging + correlation IDs (Phase 08A). Defaults shown.
# ---------------------------------------------------------------------------

# Every response echoes X-Request-ID: the client's id is accepted only when it
# is a safe header value (<= 128 chars, [A-Za-z0-9._:-]); otherwise a fresh
# cryptographic id (randomUUID) is generated. The server logs one JSON line per
# completed request (requestId, method, path, status, authenticated userId,
# durationMs) and structured server-side error records (requestId + user when
# present). Logs NEVER contain authorization headers, cookies, request bodies,
# query strings, or full AI prompts/responses.
#
# Per-request access log toggle: set to 0 to disable the request log line
# (error logs are unaffected and always emit). The test runner forces 0 so
# suites stay quiet.
# LOG_REQUESTS=1

# ---------------------------------------------------------------------------
# Role-boundary fixture (seed:roles / cleanup:roles / verify:roles).
#
# DEVELOPMENT ONLY. These are not read by the server process at all: only the
# three scripts use them, and every script refuses to run unless
# NODE_ENV is not production AND the resolved database is the development one.
#
# The four fixture accounts (role-owner / role-admin / role-manager / role-staff
# at example.invalid) share ONE password, supplied here so it never appears in a
# file that can be committed, in the shell history, or in a log line. Re-running
# seed:roles rotates it.
#
# ROLE_TEST_PASSWORD=
#
# Optional, only for `verify:roles --signin`: the PUBLIC Firebase web API key
# (the same value the mobile build ships as EXPO_PUBLIC_FIREBASE_API_KEY). It is
# not a secret and cannot read a password — it is used to perform a real
# email/password sign-in so the whole phone path is proved, not just the gate.
#
# FIREBASE_WEB_API_KEY=
