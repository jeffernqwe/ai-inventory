# Inventory AI — Backend environment (Phase 02)
# Copy this file to `.env` and set local values.
# Never commit real credentials. `.env` is git-ignored.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string. Set the real value only in server/.env — never commit it.
MONGODB_URI=

# JWT signing secret (Phase 03). Generate a strong random value in server/.env — never commit it.
# Example: openssl rand -hex 48
JWT_SECRET=

# Access-token lifetime (optional; default "7d").
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# AI Assistant (Phase 06). Keys stay server-side ONLY — never sent to the app.
# ---------------------------------------------------------------------------

# Which provider to use for the AI assistant: "claude", "gemini", or "agentrouter"
# (agentrouter = an Anthropic-compatible gateway that routes to a model such as
# DeepSeek-V4-Flash). Leave empty to run the server with the AI assistant disabled
# (chat returns 503).
AI_PROVIDER=

# Provider API keys. Set the real values only in server/.env — never commit them.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# AgentRouter gateway (Anthropic-compatible /v1/messages). Keys and the endpoint
# stay server-side ONLY — never sent to the app or to MongoDB.
AGENTROUTER_API_KEY=
# Origin/base of the gateway, e.g. https://your-router.example  (/v1/messages is appended).
AGENTROUTER_BASE_URL=
# Optional. AgentRouter's gateway only accepts traffic that looks like the Claude
# Code client (otherwise it returns "unauthorized client detected"). The app sends
# a claude-cli User-Agent plus the claude-code beta header automatically. If that
# error reappears, AgentRouter has rotated the client versions it accepts — set this
# to a currently accepted Claude Code version, e.g. claude-cli/2.1.263 (external, sdk-cli)
# AGENTROUTER_CLIENT_UA=claude-cli/2.1.263 (external, sdk-cli)

# Optional provider tuning (defaults shown).
# AI_MODEL_CLAUDE=claude-sonnet-5
# AI_MODEL_GEMINI=gemini-2.5-flash
# AI_MODEL_AGENTROUTER=deepseek-v4-flash
# AI_MAX_MESSAGE_CHARS=4000
# AI_MAX_OUTPUT_TOKENS=800
# AI_MAX_TOOL_ITERATIONS=6
# AI_CONTEXT_MESSAGES=20
# AI_REQUEST_TIMEOUT_MS=60000
# AI_RATE_LIMIT_WINDOW_MS=60000
# AI_RATE_LIMIT_MAX=20
