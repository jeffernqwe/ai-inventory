{
  "name": "inventory-ai-server",
  "version": "0.1.0",
  "description": "Inventory AI backend REST API (Express, ES Modules)",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "test": "node scripts/run-tests.mjs full",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:db": "node scripts/run-tests.mjs db",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:extensions": "node scripts/check-module-graph.mjs extensions",
    "check:specifiers": "node scripts/check-module-graph.mjs specifiers",
    "cleanup:test-mongodb": "node scripts/cleanup-mongodb.mjs --target=test --command=cleanup:test-mongodb",
    "cleanup:dev-mongodb": "node scripts/cleanup-mongodb.mjs --target=dev --command=cleanup:dev-mongodb",
    "cleanup:prod-mongodb": "node scripts/cleanup-mongodb.mjs --target=prod --command=cleanup:prod-mongodb",
    "cleanup:all-mongodb": "node scripts/cleanup-mongodb.mjs --target=all --command=cleanup:all-mongodb",
    "cleanup:test-firebase": "node scripts/cleanup-test-firebase.mjs",
    "seed:perf": "node scripts/seed-perf-data.mjs",
    "cleanup:perf": "node scripts/cleanup-perf-data.mjs",
    "perf:measure": "node scripts/measure-ai-tools.mjs",
    "perf:golden": "node scripts/capture-ai-golden.mjs",
    "perf:turns": "node scripts/measure-ai-turns.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
