{
  "name": "inventory-ai-server",
  "version": "0.1.0",
  "description": "Inventory AI backend REST API (Express, ES Modules)",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "test": "node scripts/run-tests.mjs full",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:db": "node scripts/run-tests.mjs db",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:extensions": "node scripts/check-module-graph.mjs extensions",
    "check:specifiers": "node scripts/check-module-graph.mjs specifiers"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
